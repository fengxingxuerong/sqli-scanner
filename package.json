{
  "name": "sqli-scanner",
  "version": "1.0.0",
  "description": "SQL 注入检测工具（Web 全栈 + Tauri 桌面壳，一份代码双形态）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "server": "cd server && node index.js",
    "waf-lab": "node e2e/waf-lab/lab-server.js",
    "waf-lab-v2": "node e2e/waf-lab/lab-server-v2.js",
    "waf-e2e": "node e2e/waf-lab/compare.e2e.js",
    "tamper-matrix": "node e2e/tamper-matrix/tamper-test.mjs",
    "waf-validate": "node e2e/waf-lab/validate-tamper.mjs",
    "waf-real": "node e2e/waf-real/waf-verify.mjs",
    "waf-auto": "node e2e/waf-real/waf-auto-check.mjs",
    "e2e:file-read": "node e2e/fileops/exploit-file-read.e2e.mjs",
    "e2e:file-write": "node e2e/fileops/exploit-file-write.e2e.mjs",
    "tauri": "tauri",
    "build:engine": "node scripts/build-engine.mjs",
    "build:tauri": "npm run build && npm run build:engine && tauri build",
    "package:win": "npm run build && npm run build:engine && tauri build --runner cargo --target x86_64-pc-windows-msvc",
    "package:mac": "npm run build && npm run build:engine && tauri build --runner cargo --target universal-apple-darwin",
    "typecheck": "tsc --noEmit",
    "test:server": "cd server && npm test",
    "test:all": "npm run test && npm run test:server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "node scripts/run-coverage.mjs",
    "lint": "eslint .",
    "prepare": "husky",
    "recall-e2e": "node e2e/recall-lab/recall.e2e.js",
    "sqlmap-benchmark": "node e2e/recall-lab/sqlmap-benchmark.e2e.js",
    "real-lab": "node e2e/real-world-lab/server.js",
    "real-verify": "node e2e/real-world-lab/verify.mjs",
    "test:detection": "node e2e/detection-runner/run.js",
    "acceptance": "node e2e/acceptance.mjs",
    "lab:redteam": "node e2e/redteam-lab/env.mjs",
    "redteam:truth": "node e2e/redteam-lab/selftest.mjs",
    "redteam:r1": "node e2e/redteam-lab/run-scan.mjs r1",
    "redteam:r2": "node e2e/redteam-lab/run-scan.mjs r2",
    "redteam:report": "node e2e/redteam-lab/report.mjs",
    "redteam:sqlmap": "node e2e/redteam-lab/sqlmap-bench.mjs",
    "demo:report": "node e2e/demo/deliverable-demo.mjs",
    "typecheck:server": "tsc -p server/tsconfig.json"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "@tauri-apps/api": "^2.0.0",
    "axios": "^1.18.1",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.2",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
