{
  "version": 1,
  "_note": "[D256] 方言知识真源。新增一种 DBMS = 在本文件加一个 dialects 条目，不需要改 DialectSqlBuilder.js。占位符：${s}=标量表达式、${id}=已包裹的标识符、${t}=表名、${db}=库名；转义变体 ${tDq}/${tBr}/${tBt}/${dbBt} 由解释器注入。缺字段一律回落 defaults。历史实测取证见 docs/方言声明化-D256.md。",
  "aliasPatterns": [
    { "pattern": "mariadb|tidb|oceanbase|cubrid|\\bgbase\\b|maxdb|sap\\s*db", "target": "MySQL" },
    { "pattern": "dm8|dameng", "target": "Oracle" },
    { "pattern": "cockroachdb|kingbase|kingbasees|vertica", "target": "PostgreSQL" }
  ],
  "driverDialects": {
    "mysql": "MySQL", "mariadb": "MariaDB", "tidb": "TiDB",
    "postgres": "PostgreSQL", "postgresql": "PostgreSQL",
    "sqlite": "SQLite",
    "sqlserver": "SQL Server", "mssql": "SQL Server",
    "oracle": "Oracle", "dm8": "DM8", "dameng": "DM8",
    "clickhouse": "ClickHouse", "db2": "DB2", "sybase": "Sybase",
    "firebird": "Firebird", "informix": "Informix",
    "h2": "H2", "access": "Access", "hsqldb": "HSQLDB",
    "derby": "Derby", "monetdb": "MonetDB",
    "oceanbase": "MySQL", "cubrid": "MySQL", "gbase": "MySQL", "maxdb": "MySQL",
    "cockroachdb": "PostgreSQL", "cockroach": "PostgreSQL",
    "kingbase": "PostgreSQL", "kingbasees": "PostgreSQL", "vertica": "PostgreSQL"
  },
  "defaults": {
    "fromDummy": "",
    "identifier": { "open": "", "close": "" },
    "quoteCol": { "open": "\"", "close": "\"" },
    "tableRef": "\"${tDq}\"",
    "nnExpr": "${id}",
    "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
    "inlineConcat": "||",
    "hashComment": false
  },
  "highFreq": [
    "MySQL", "PostgreSQL", "SQL Server", "Oracle", "SQLite",
    "MariaDB", "TiDB", "DM8", "ClickHouse", "Sybase",
    "DB2", "Firebird", "Informix", "H2", "Access", "HSQLDB", "Derby", "MonetDB"
  ],
  "dialects": {
    "MySQL": {
      "fromDummy": "",
      "identifier": { "open": "`", "close": "`" },
      "quoteCol": { "open": "`", "close": "`" },
      "tableRef": "`${dbBt}`.`${tBt}`",
      "nnExpr": "IFNULL(CAST(${id} AS CHAR),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "CONVERT(CONCAT('__S__',CAST((${s}) AS CHAR),'__E__') USING utf8mb4) COLLATE utf8mb4_bin",
      "wrapNoCast": "CONCAT('__S__',(${s}),'__E__')",
      "inlineConcat": "||",
      "hashComment": true
    },
    "MariaDB": {
      "fromDummy": "",
      "identifier": { "open": "`", "close": "`" },
      "quoteCol": { "open": "`", "close": "`" },
      "tableRef": "`${dbBt}`.`${tBt}`",
      "nnExpr": "IFNULL(CAST(${id} AS CHAR),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "CONVERT(CONCAT('__S__',CAST((${s}) AS CHAR),'__E__') USING utf8mb4) COLLATE utf8mb4_bin",
      "wrapNoCast": "CONCAT('__S__',(${s}),'__E__')",
      "inlineConcat": "||",
      "hashComment": true
    },
    "TiDB": {
      "fromDummy": "",
      "identifier": { "open": "`", "close": "`" },
      "quoteCol": { "open": "`", "close": "`" },
      "tableRef": "`${dbBt}`.`${tBt}`",
      "nnExpr": "IFNULL(CAST(${id} AS CHAR),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "CONVERT(CONCAT('__S__',CAST((${s}) AS CHAR),'__E__') USING utf8mb4) COLLATE utf8mb4_bin",
      "wrapNoCast": "CONCAT('__S__',(${s}),'__E__')",
      "inlineConcat": "||",
      "hashComment": true
    },
    "PostgreSQL": {
      "fromDummy": "",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "COALESCE(CAST(${id} AS text),'')",
      "nullSafeQuoteCol": "COALESCE(CAST(${id} AS text),'')",
      "wrap": "('__S__' || CAST((${s}) AS TEXT) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "SQLite": {
      "fromDummy": "",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "`", "close": "`" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "IFNULL(CAST(${id} AS TEXT),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS TEXT),'')",
      "wrap": "('__S__' || (${s}) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "SQL Server": {
      "fromDummy": "",
      "identifier": { "open": "[", "close": "]" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "[${tBr}]",
      "nnExpr": "ISNULL(CAST(${id} AS nvarchar(max)),'')",
      "nullSafeQuoteCol": "ISNULL(CAST(${id} AS nvarchar(max)),'')",
      "wrap": "('__S__'+CAST((${s}) AS VARCHAR(MAX))+'__E__')",
      "inlineConcat": "+",
      "hashComment": false
    },
    "Oracle": {
      "fromDummy": " FROM dual",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "NVL(CAST(${id} AS VARCHAR2(4000)),'')",
      "nullSafeQuoteCol": "NVL(CAST(${id} AS VARCHAR2(4000)),'')",
      "wrap": "('__S__' || TO_CHAR((${s})) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "DM8": {
      "fromDummy": " FROM dual",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "NVL(CAST(${id} AS VARCHAR2(4000)),'')",
      "nullSafeQuoteCol": "NVL(CAST(${id} AS VARCHAR2(4000)),'')",
      "wrap": "('__S__' || TO_CHAR((${s})) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "ClickHouse": {
      "fromDummy": "",
      "identifier": { "open": "`", "close": "`" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "`${dbBt}`.`${tBt}`",
      "nnExpr": "ifNull(toString(${id}),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "concat('__S__', toString((${s})), '__E__')",
      "wrapNoCast": "concat('__S__', (${s}), '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "Sybase": {
      "fromDummy": "",
      "identifier": { "open": "[", "close": "]" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "ISNULL(CAST(${id} AS VARCHAR(4000)),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "('__S__'+CAST((${s}) AS VARCHAR(MAX))+'__E__')",
      "inlineConcat": "+",
      "hashComment": false
    },
    "DB2": {
      "fromDummy": " FROM SYSIBM.SYSDUMMY1",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "COALESCE(CAST(${id} AS VARCHAR(4000)),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "('__S__' || CAST((${s}) AS VARCHAR(4000)) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "Firebird": {
      "fromDummy": " FROM RDB$DATABASE",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "COALESCE(CAST(${id} AS VARCHAR(4000)),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "('__S__' || CAST((${s}) AS VARCHAR(4000)) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "Informix": {
      "fromDummy": " FROM systables WHERE tabid=1",
      "identifier": { "open": "", "close": "" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "${id}",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "('__S__' || CAST((${s}) AS VARCHAR(4000)) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "H2": {
      "fromDummy": "",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "IFNULL(CAST(${id} AS VARCHAR),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "('__S__' || CAST((${s}) AS VARCHAR(4000)) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "Access": {
      "fromDummy": " FROM MSysObjects",
      "identifier": { "open": "[", "close": "]" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "${id}",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "('__S__' & CStr(${s}) & '__E__')",
      "wrapNoCast": "('__S__' & (${s}) & '__E__')",
      "inlineConcat": "&",
      "hashComment": false
    },
    "HSQLDB": {
      "fromDummy": " FROM (VALUES(0)) t",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "IFNULL(CAST(${id} AS CHAR),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "('__S__' || CAST((${s}) AS VARCHAR(1000)) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "Derby": {
      "fromDummy": " FROM SYSIBM.SYSDUMMY1",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "COALESCE(CAST(${id} AS VARCHAR(4000)),'')",
      "nullSafeQuoteCol": "COALESCE(CAST(${id} AS VARCHAR(4000)),'')",
      "wrap": "('__S__' || CAST((${s}) AS VARCHAR(32672)) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    },
    "MonetDB": {
      "fromDummy": " FROM sys.version",
      "identifier": { "open": "\"", "close": "\"" },
      "quoteCol": { "open": "\"", "close": "\"" },
      "tableRef": "\"${tDq}\"",
      "nnExpr": "IFNULL(CAST(${id} AS CHAR),'')",
      "nullSafeQuoteCol": "IFNULL(CAST(${id} AS CHAR),'')",
      "wrap": "('__S__' || CAST((${s}) AS VARCHAR(1024)) || '__E__')",
      "wrapNoCast": "('__S__' || (${s}) || '__E__')",
      "inlineConcat": "||",
      "hashComment": false
    }
  }
}
